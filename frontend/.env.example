VITE_API_URL=http://localhost:8080
# Client ID OAuth 2.0 (tipo "Aplicativo da Web") criado no Google Cloud Console.
# Precisa ser o MESMO client ID configurado em backend/.env (GOOGLE_CLIENT_ID).
# É público por natureza (vai no bundle do frontend) — a segurança do login não
# depende de mantê-lo em segredo, e sim da validação do token feita no backend.
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
