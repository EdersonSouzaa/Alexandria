PORT=8080
DATABASE_URL=postgresql://postgres:sua_senha_local@localhost:5432/alexandria_web?schema=public
JWT_SECRET=troque_por_uma_chave_forte_com_no_minimo_32_caracteres
FRONTEND_URL=http://localhost:5173,https://seu-projeto.vercel.app
# Client ID OAuth 2.0 (tipo "Aplicativo da Web") criado no Google Cloud Console.
# Precisa ser o MESMO client ID usado em frontend/.env (VITE_GOOGLE_CLIENT_ID) —
# o backend usa esse valor como "audience" para validar o ID Token recebido do Google.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
